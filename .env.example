# Local dev and builds need none of these: without BLOB_READ_WRITE_TOKEN the site renders the committed data/posts.
# `bun run sync` needs the NOTION_* values (and the Blob token for media and --blob). Production (Vercel) needs all of
# them plus CRON_SECRET, which lets Vercel Cron bypass the /api/sync cooldown.
NOTION_TOKEN=
NOTION_DATABASE_ID=70e65672866344c6991bfb1ee481d348
NOTION_DATA_SOURCE_ID=eae62566-3532-4a92-a7f1-f8b270248bc6
NOTION_PUBLISH_FILTER='{"property":"Tags","multi_select":{"does_not_contain":"Draft"}}'
NOTION_DATE_PROPERTY=Date
NOTION_EXCERPT_PROPERTY=Excerpt
BLOB_READ_WRITE_TOKEN=
# Set to `local` to render data/posts and the code defaults despite a Blob token.
POSTS_SOURCE=
# At least 16 characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=

# Editable site (docs/editable-site.md, README → Editable site). All optional: without them the editor, sign-in, and /studio
# stay quietly off. In Vercel, scope every secret in this file to Production only: previews are built from branches an agent wrote.
# Neon Postgres connection string (auth sessions and studio threads); apply the schema with `bun run db:push`.
DATABASE_URL=
# Better Auth signing secret, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# The site's public origin, e.g. http://localhost:3000 locally. In production the studio also uses it to fetch pages and as the sandbox's callback origin.
BETTER_AUTH_URL=
# GitHub OAuth app used for sign-in (callback: <BETTER_AUTH_URL>/api/auth/callback/github).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user id of the one account allowed to edit (defaults to 856034).
OWNER_GITHUB_ID=
# Model key for /studio (fast lane, and the only secret passed into the code-lane sandbox). Use a key with a spend limit.
# Set one: OPENROUTER_API_KEY (used through OpenRouter's Anthropic-compatible endpoint, and wins if both are set) or ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Model for the fast lane (defaults to claude-sonnet-5-5).
STUDIO_FAST_MODEL=
# Model for the code lane (defaults to claude-opus-5-5).
STUDIO_CODE_MODEL=
# Fine-grained GitHub token for this one repo (Contents and Pull requests read/write, Deployments read). The server uses it to
# commit, open, merge, and revert code-lane pull requests; it is never given to the sandbox.
GITHUB_TOKEN=
# The repository those pull requests go to, as owner/name (defaults to akrolsmir/austin-site).
GITHUB_REPO=
# Set to 1 outside production to act as the owner without signing in (ignored when NODE_ENV=production).
EDITOR_DEV_OWNER=
# Preview environment only: 1 makes everyone who can open a Vercel preview the owner there (previews use their own data).
EDITOR_PREVIEW_OWNER=

# Set by Vercel, never by hand: VERCEL_ENV (anything but "production" turns sign-in, the studio, and the database off),
# VERCEL_PROJECT_PRODUCTION_URL (the origin when BETTER_AUTH_URL is unset), VERCEL_GIT_COMMIT_SHA and VERCEL_DEPLOYMENT_ID
# (recorded by the sync so a new build reconverts posts). The Vercel Sandbox SDK uses the deployment's own OIDC token.
# Set by the code lane inside its sandbox only: STUDIO_RUN_ID, STUDIO_RUN_TOKEN, STUDIO_CALLBACK_URL.
