# Local dev and builds need none of these: without BLOB_READ_WRITE_TOKEN the site renders the committed data/posts.
# `bun run sync` needs the NOTION_* values (and the Blob token for media and --blob). Production (Vercel) needs all of
# them plus CRON_SECRET, which lets Vercel Cron bypass the /api/sync cooldown. Set POSTS_SOURCE=local to render data/posts despite a Blob token.
NOTION_TOKEN=
NOTION_DATABASE_ID=70e65672866344c6991bfb1ee481d348
NOTION_DATA_SOURCE_ID=eae62566-3532-4a92-a7f1-f8b270248bc6
NOTION_PUBLISH_FILTER='{"property":"Tags","multi_select":{"does_not_contain":"Draft"}}'
NOTION_DATE_PROPERTY=Date
NOTION_EXCERPT_PROPERTY=Excerpt
BLOB_READ_WRITE_TOKEN=
# At least 16 characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=

# Editable site (docs/editable-site.md). All optional: without them the editor, sign-in, and /studio stay quietly off.
# Neon Postgres connection string (auth sessions and studio threads); apply the schema with `bun run db:push`.
DATABASE_URL=
# Better Auth signing secret, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# The site's public origin, e.g. http://localhost:3000 locally.
BETTER_AUTH_URL=
# GitHub OAuth app used for sign-in (callback: <BETTER_AUTH_URL>/api/auth/callback/github).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user id of the one account allowed to edit (defaults to 856034).
OWNER_GITHUB_ID=
# Anthropic API key for /studio (fast lane, and the only secret passed into the code-lane sandbox).
ANTHROPIC_API_KEY=
# Model for the fast lane (defaults to claude-sonnet-5-5).
STUDIO_FAST_MODEL=
# Model for the code lane (defaults to claude-opus-5-5).
STUDIO_CODE_MODEL=
# GitHub token the server uses to commit, open, and merge code-lane pull requests (never given to the sandbox).
GITHUB_TOKEN=
# The repository those pull requests go to, as owner/name.
GITHUB_REPO=
# Set to 1 outside production to act as the owner without signing in (ignored when NODE_ENV=production).
EDITOR_DEV_OWNER=
