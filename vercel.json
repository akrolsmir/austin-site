{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/studio/tick",
      "schedule": "*/10 * * * *"
    }
  ]
}
