      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "I would poach 20 of my friends from the Silicon Valley FAANG circuit, and start 7-10 startups of 2-3 people each. Each person gets $500k in exchange for 7% investment (suggested: 2 years of salary at $150k/year, plus $200k for spend on hiring/compute/other stuff), to work on a tech project. Project ideas:",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "I would poach 20 of my friends from the Silicon Valley FAANG circuit, and start 7-10 startups of 2-3 people each. Each person gets $500k in exchange for 7% investment (suggested: 2 years of salary at $150k/year, plus $200k for spend on hiring/compute/other stuff), to work on a tech project. Project ideas:",
