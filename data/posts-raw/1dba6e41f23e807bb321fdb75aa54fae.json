            "type": "text",
            "text": {
              "content": "Received startup wisdom: \"startups die of suicide not murder\" -- aka running out of steam is why a company fails, not being killed by competition. plan accordingly!",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
