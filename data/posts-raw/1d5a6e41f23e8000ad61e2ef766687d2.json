          "bulleted_list_item": {
            "rich_text": [
              {
                "type": "text",
                "text": {
                  "content": "Being able to do this well is a superpower. It wins friends & influences people. To sell something to someone, you need to be able to speak his language, know what matters to him, simulate his responses ahead of time",
                  "link": null
                },
                "annotations": {
