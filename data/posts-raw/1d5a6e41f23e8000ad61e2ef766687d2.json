      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Do these behaviors seem kind of backwards, quaint? At a Manifest side session, one Asian rationalist complained about how confusing and stifling these guess culture norms were for him, growing up. Why not just state things plainly, say what you mean?",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
