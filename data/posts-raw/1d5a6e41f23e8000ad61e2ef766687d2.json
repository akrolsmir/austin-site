          },
          "created_time": "2025-04-14T15:37:00.000Z",
          "last_edited_time": "2026-08-16T17:48:00.000Z",
          "created_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "last_edited_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "has_children": true,
          "in_trash": false,
          "type": "bulleted_list_item",
          "bulleted_list_item": {
            "rich_text": [
              {
                "type": "text",
                "text": {
                  "content": "Jenn describes how ",
                  "link": null
                },
                "annotations": {
                  "bold": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false,
                  "code": false,
                  "color": "default"
                },
                "plain_text": "Jenn describes how ",
                "href": null
              },
              {
                "type": "text",
                "text": {
                  "content": "rich people solve problems with money, whereas poor people rely on favors from friends",
                  "link": {
                    "url": "https://www.jenn.site/rich-friend-poor-friend/"
                  }
                },
                "annotations": {
                  "bold": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false,
                  "code": false,
                  "color": "default"
                },
                "plain_text": "rich people solve problems with money, whereas poor people rely on favors from friends",
                "href": "https://www.jenn.site/rich-friend-poor-friend/"
              },
              {
                "type": "text",
                "text": {
                  "content": ". For example, a rich person might book an Uber to get to the airport, while a poor person might might get a ride from a friend, with the implicit expectation that she’d return the favor in some way down the line. Which one would you rather be?",
                  "link": null
                },
                "annotations": {
                  "bold": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false,
                  "code": false,
                  "color": "default"
                },
                "plain_text": ". For example, a rich person might book an Uber to get to the airport, while a poor person might might get a ride from a friend, with the implicit expectation that she’d return the favor in some way down the line. Which one would you rather be?",
                "href": null
              }
            ],
            "color": "default"
          },
          "children": [
            {
              "object": "block",
              "id": "1d5a6e41-f23e-80f3-a5e8-e75ec8e37d7f",
              "parent": {
                "type": "block_id",
                "block_id": "1d5a6e41-f23e-808f-bdd1-d9a823797d9e"
              },
              "created_time": "2025-04-14T15:45:00.000Z",
              "last_edited_time": "2025-04-14T15:51:00.000Z",
              "created_by": {
                "object": "user",
                "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
              },
              "last_edited_by": {
                "object": "user",
                "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
              },
              "has_children": false,
              "in_trash": false,
              "type": "bulleted_list_item",
              "bulleted_list_item": {
                "rich_text": [
                  {
                    "type": "text",
                    "text": {
                      "content": "I think one contributor to “the loneliness pandemic” comes from cheap, efficient, financialized services disintermediating classic human dependencies. Hiring movers instead of moving with friends; ordering Doordash instead of cooking together; Ubering instead of carpooling; AirBnB instead of crashing a friend’s couch.",
                      "link": null
                    },
                    "annotations": {
                      "bold": false,
                      "italic": false,
                      "strikethrough": false,
                      "underline": false,
                      "code": false,
                      "color": "default"
                    },
                    "plain_text": "I think one contributor to “the loneliness pandemic” comes from cheap, efficient, financialized services disintermediating classic human dependencies. Hiring movers instead of moving with friends; ordering Doordash instead of cooking together; Ubering instead of carpooling; AirBnB instead of crashing a friend’s couch.",
                    "href": null
                  }
                ],
                "color": "default"
              }
            }
          ]
        }
