      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "I think there are many good things about the explicitness of ask culture — or the hypothetical rationalist ideal of “",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "I think there are many good things about the explicitness of ask culture — or the hypothetical rationalist ideal of “",
            "href": null
          },
          {
            "type": "text",
            "text": {
              "content": "tell culture",
              "link": {
                "url": "https://www.lesswrong.com/posts/vs3kzjLhbdKsndnBy/ask-and-guess"
              }
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "tell culture",
            "href": "https://www.lesswrong.com/posts/vs3kzjLhbdKsndnBy/ask-and-guess"
          },
          {
            "type": "text",
            "text": {
              "content": "”. (It certainly makes things easier for those on the more autistic side.) But I also think that being guess-y has been quite good for my own work and social life; and that me being guess-y has helped me lead a variety of projects, teams, and communities.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
