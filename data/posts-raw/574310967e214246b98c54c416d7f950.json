      },
      "has_children": true,
      "in_trash": false,
      "type": "bulleted_list_item",
      "bulleted_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Earning the difference on the “bid-ask spread”. E.g. if I’m willing to sell blueberries for $0.03 or buy them for $0.01, then every time I buy and sell a blueberry I make $0.02 of profit",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Earning the difference on the “bid-ask spread”. E.g. if I’m willing to sell blueberries for $0.03 or buy them for $0.01, then every time I buy and sell a blueberry I make $0.02 of profit",
            "href": null
          }
        ],
        "color": "default"
      },
