      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "But — someone always has to be the first to make an offer, otherwise a trade will never happen! There are a few ways of encouraging people to provide liquidity (also known as “serve as a market maker” or “make markets”):",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "But — someone always has to be the first to make an offer, otherwise a trade will never happen! There are a few ways of encouraging people to provide liquidity (also known as “serve as a market maker” or “make markets”):",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "b6f2ed42-d50d-4bae-a677-419e436aac0b",
      "parent": {
        "type": "page_id",
        "page_id": "57431096-7e21-4246-b98c-54c416d7f950"
      },
      "created_time": "2022-06-03T06:26:00.000Z",
