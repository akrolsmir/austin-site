      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Aside: Should you forgo all payment?",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Aside: Should you forgo all payment?",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      },
      "children": [
        {
          "object": "block",
          "id": "196a6e41-f23e-8032-9c15-ffb32d99a0a5",
          "parent": {
            "type": "block_id",
            "block_id": "196a6e41-f23e-8040-917b-c8818be1ca82"
          },
          "created_time": "2025-02-10T07:20:00.000Z",
          "last_edited_time": "2025-02-10T07:20:00.000Z",
          "created_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "last_edited_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "has_children": true,
          "in_trash": false,
          "type": "bulleted_list_item",
          "bulleted_list_item": {
            "rich_text": [
              {
                "type": "text",
                "text": {
                  "content": "Probably not. Money is still a useful tool now, to ensure sustainable cycles. cf: Parable of Talents; Render unto Caesar.",
                  "link": null
                },
                "annotations": {
                  "bold": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false,
                  "code": false,
                  "color": "default"
                },
                "plain_text": "Probably not. Money is still a useful tool now, to ensure sustainable cycles. cf: Parable of Talents; Render unto Caesar.",
                "href": null
              }
            ],
            "color": "default"
          },
          "children": [
            {
              "object": "block",
              "id": "17fa6e41-f23e-805a-a79b-eea9f34b4682",
              "parent": {
                "type": "block_id",
                "block_id": "196a6e41-f23e-8032-9c15-ffb32d99a0a5"
              },
              "created_time": "2025-01-18T00:16:00.000Z",
              "last_edited_time": "2025-02-10T07:20:00.000Z",
              "created_by": {
                "object": "user",
                "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
              },
              "last_edited_by": {
                "object": "user",
                "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
              },
              "has_children": false,
              "in_trash": false,
              "type": "bulleted_list_item",
              "bulleted_list_item": {
                "rich_text": [
                  {
                    "type": "text",
                    "text": {
                      "content": "But: if you can forgo it, the eventual payout will be much higher. E.g. vaccine researcher and tobacco marketer both making $100k/y, vaccine researcher gets more in the way of certs",
                      "link": null
                    },
                    "annotations": {
                      "bold": false,
                      "italic": false,
                      "strikethrough": false,
                      "underline": false,
                      "code": false,
                      "color": "default"
                    },
                    "plain_text": "But: if you can forgo it, the eventual payout will be much higher. E.g. vaccine researcher and tobacco marketer both making $100k/y, vaccine researcher gets more in the way of certs",
                    "href": null
                  }
                ],
                "color": "default"
              }
            }
          ]
        },
        {
          "object": "block",
          "id": "17fa6e41-f23e-8047-8d2f-c4414a1d4434",
          "parent": {
            "type": "block_id",
            "block_id": "196a6e41-f23e-8040-917b-c8818be1ca82"
          },
          "created_time": "2025-01-18T00:21:00.000Z",
          "last_edited_time": "2025-02-10T07:20:00.000Z",
          "created_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "last_edited_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "has_children": false,
          "in_trash": false,
          "type": "bulleted_list_item",
