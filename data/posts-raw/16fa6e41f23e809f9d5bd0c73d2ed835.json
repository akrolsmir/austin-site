          },
          "created_time": "2025-01-02T21:45:00.000Z",
          "last_edited_time": "2025-01-02T21:47:00.000Z",
          "created_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "last_edited_by": {
            "object": "user",
            "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
          },
          "has_children": false,
          "in_trash": false,
          "type": "bulleted_list_item",
          "bulleted_list_item": {
            "rich_text": [
              {
                "type": "text",
                "text": {
                  "content": "Even if you’re serving charities — if those charities can’t raise enough money to pay for your service, it’s a sign that their work isn’t very good.",
                  "link": null
