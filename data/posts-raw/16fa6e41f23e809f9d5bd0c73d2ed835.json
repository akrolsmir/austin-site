      },
      "has_children": true,
      "in_trash": false,
      "type": "bulleted_list_item",
      "bulleted_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Ask your users to pay you. E.g. FAR labs & Lighthaven ask the people using the space (event operators, or users) to pay for the service. This grounds the value of your work; and builds useful muscles for operating in regular capitalist spaces.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Ask your users to pay you. E.g. FAR labs & Lighthaven ask the people using the space (event operators, or users) to pay for the service. This grounds the value of your work; and builds useful muscles for operating in regular capitalist spaces.",
            "href": null
          }
        ],
        "color": "default"
      },
      "children": [
        {
