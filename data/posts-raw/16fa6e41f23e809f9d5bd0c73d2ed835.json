      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "I think there’s a lesser (but real) version of this, where by taking on money from a particular grantmaker, you end up adjusting you (or your org’s) values to appeal to that grantmaker.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "I think there’s a lesser (but real) version of this, where by taking on money from a particular grantmaker, you end up adjusting you (or your org’s) values to appeal to that grantmaker.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
