      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "When you take a grant you psychologically commit to doing the thing you said you'd do, sometimes too early. You might still need time to traverse the idea maze — but to get a grant, you’re often forced into articulating a vision of what you’d do with that funding",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "When you take a grant you psychologically commit to doing the thing you said you'd do, sometimes too early. You might still need time to traverse the idea maze — but to get a grant, you’re often forced into articulating a vision of what you’d do with that funding",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
