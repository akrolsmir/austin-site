      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "“Audience capture” describes the phenomenon where bloggers, influencers etc are slowly manipulated into different people as a result of the audience they try and cater to.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "“Audience capture” describes the phenomenon where bloggers, influencers etc are slowly manipulated into different people as a result of the audience they try and cater to.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
