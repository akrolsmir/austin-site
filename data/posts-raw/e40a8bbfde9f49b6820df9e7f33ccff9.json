            "rich_text": [
              {
                "type": "text",
                "text": {
                  "content": "Feeling when you look at someone and they don’t have anything interesting to say about what they’ve been up to",
                  "link": null
                },
                "annotations": {
                  "bold": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false,
                  "code": false,
                  "color": "default"
                },
                "plain_text": "Feeling when you look at someone and they don’t have anything interesting to say about what they’ve been up to",
