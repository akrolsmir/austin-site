          "type": "bulleted_list_item",
          "bulleted_list_item": {
            "rich_text": [
              {
                "type": "text",
                "text": {
                  "content": "Being underclocked is horrible. It’s when you have nothing driving you. When you start asking “so what”? When you start searching for meaning.",
                  "link": null
                },
                "annotations": {
                  "bold": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false,
                  "code": false,
                  "color": "default"
                },
                "plain_text": "Being underclocked is horrible. It’s when you have nothing driving you. When you start asking “so what”? When you start searching for meaning.",
                "href": null
              }
            ],
            "color": "default"
          }
        },
