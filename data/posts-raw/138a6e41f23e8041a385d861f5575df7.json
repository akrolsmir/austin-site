      "type": "numbered_list_item",
      "numbered_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Effective allocation: The best predictor of whether someone can succeed is whether they've succeeded before.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Effective allocation: The best predictor of whether someone can succeed is whether they've succeeded before.",
            "href": null
          }
        ],
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "138a6e41-f23e-80be-aeed-d37ab12c4e9e",
      "parent": {
        "type": "page_id",
        "page_id": "138a6e41-f23e-8041-a385-d861f5575df7"
      },
      "created_time": "2024-11-08T08:06:00.000Z",
      "last_edited_time": "2024-11-08T08:06:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "numbered_list_item",
      "numbered_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Grantee freedom: Retroactive funding is maximally unrestricted, meaning grantees can pursue what seems best to them rather than what is most legible.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Grantee freedom: Retroactive funding is maximally unrestricted, meaning grantees can pursue what seems best to them rather than what is most legible.",
            "href": null
          }
        ],
        "color": "default"
      }
    },
    {
      "object": "block",
