    {
      "object": "block",
      "id": "138a6e41-f23e-80ba-b4dd-ccb655b269e0",
      "parent": {
        "type": "page_id",
        "page_id": "138a6e41-f23e-8041-a385-d861f5575df7"
      },
      "created_time": "2024-11-08T08:06:00.000Z",
      "last_edited_time": "2024-11-08T08:06:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "numbered_list_item",
      "numbered_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Attracting talent: Retroactive payments can narrow the salary gap, sending a market signal which ultimately encourages more competent folks into the charitable sector.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Attracting talent: Retroactive payments can narrow the salary gap, sending a market signal which ultimately encourages more competent folks into the charitable sector.",
            "href": null
          }
        ],
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "138a6e41-f23e-8049-be4d-ca6f8d338d2c",
      "parent": {
        "type": "page_id",
        "page_id": "138a6e41-f23e-8041-a385-d861f5575df7"
      },
      "created_time": "2024-11-08T08:06:00.000Z",
      "last_edited_time": "2024-11-08T08:06:00.000Z",
      "created_by": {
        "object": "user",
