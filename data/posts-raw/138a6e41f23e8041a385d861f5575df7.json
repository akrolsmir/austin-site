    {
      "object": "block",
      "id": "138a6e41-f23e-8069-84b6-d6d3ad887a43",
      "parent": {
        "type": "page_id",
        "page_id": "138a6e41-f23e-8041-a385-d861f5575df7"
      },
      "created_time": "2024-11-08T08:06:00.000Z",
      "last_edited_time": "2024-11-08T08:06:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Alignment: if someone has done work you really like, probably they are excited to do more work like that. Instead of asking grantees to continually ask for more money with a concrete plan on how to spend it - why not just let them do whatever they want?",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Alignment: if someone has done work you really like, probably they are excited to do more work like that. Instead of asking grantees to continually ask for more money with a concrete plan on how to spend it - why not just let them do whatever they want?",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "138a6e41-f23e-808d-bc88-ee4e89d0d574",
      "parent": {
        "type": "page_id",
