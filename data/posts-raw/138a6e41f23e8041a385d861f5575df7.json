      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "(Many industries that care about talent like quant trading firms and big tech pay out a large fraction of compensation in end-of-year performance-based bonuses, which function similarly to retroactive donations.)",
              "link": null
