      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Most nonprofit grants made today are prospective (made before the work is done), restricted (limited to doing a specific thing), and cost-based (seeking to cover exactly what the project cost).",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Most nonprofit grants made today are prospective (made before the work is done), restricted (limited to doing a specific thing), and cost-based (seeking to cover exactly what the project cost).",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "138a6e41-f23e-8099-9c85-edda125895c5",
      "parent": {
        "type": "page_id",
        "page_id": "138a6e41-f23e-8041-a385-d861f5575df7"
      },
      "created_time": "2024-11-08T08:06:00.000Z",
      "last_edited_time": "2024-11-08T08:06:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
