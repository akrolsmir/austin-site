      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "I claim that donors should shift towards retrospective, unrestricted, value-based grants.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "I claim that donors should shift towards retrospective, unrestricted, value-based grants.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "138a6e41-f23e-80ea-a9a4-d9a9f4bc590f",
      "parent": {
        "type": "page_id",
        "page_id": "138a6e41-f23e-8041-a385-d861f5575df7"
      },
      "created_time": "2024-11-08T08:06:00.000Z",
      "last_edited_time": "2024-11-08T08:06:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "numbered_list_item",
      "numbered_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Easier evaluation: It's much easier to tell which projects were good, after the project has finished. Many projects never even get off the ground; many projects that do what they said they would do, never realize the impact they thought they would. Retroactive funders don't have to pay out for those.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Easier evaluation: It's much easier to tell which projects were good, after the project has finished. Many projects never even get off the ground; many projects that do what they said they would do, never realize the impact they thought they would. Retroactive funders don't have to pay out for those.",
            "href": null
          }
        ],
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "138a6e41-f23e-805a-a865-f7e0b492bc57",
      "parent": {
        "type": "page_id",
        "page_id": "138a6e41-f23e-8041-a385-d861f5575df7"
      },
      "created_time": "2024-11-08T08:06:00.000Z",
      "last_edited_time": "2024-11-08T08:06:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
