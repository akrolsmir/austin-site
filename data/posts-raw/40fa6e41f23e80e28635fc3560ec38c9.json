      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "The internet led to a new kind of community becoming possible: forums, Discord chat, Twitter exchanges. (Also, community for specific kinds of people. Manifold started as an online community; I hear EA & rationalism did too.)",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "The internet led to a new kind of community becoming possible: forums, Discord chat, Twitter exchanges. (Also, community for specific kinds of people. Manifold started as an online community; I hear EA & rationalism did too.)",
            "href": null
          }
        ],
        "icon": null,
