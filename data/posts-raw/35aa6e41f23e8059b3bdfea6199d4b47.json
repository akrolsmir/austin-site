      "has_children": false,
      "in_trash": false,
      "type": "bulleted_list_item",
      "bulleted_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "I think I met Panda first, I think back when Elicit was still Ought? First at a Manifest, perhaps, and then repeatedly through Taco Tuesdays. He’s always been kind, warm, candid, genuine, someone whose every interaction with others makes them better off.",
              "link": null
            },
            "annotations": {
