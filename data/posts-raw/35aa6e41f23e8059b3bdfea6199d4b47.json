    {
      "object": "block",
      "id": "35aa6e41-f23e-80f6-8220-cb9cbf9cc43d",
      "parent": {
        "type": "page_id",
        "page_id": "35aa6e41-f23e-8059-b3bd-fea6199d4b47"
      },
      "created_time": "2026-05-08T05:17:00.000Z",
      "last_edited_time": "2026-05-08T05:21:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "bulleted_list_item",
      "bulleted_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "But Venki I got to know better, after he started showing up at Mox. He felt kindred, sharing many of my obsessions and my favorite references. In the last couple years, I’ve spent a lot of time with people in EA, which I now consider my adopted tribe; but many conversations with Venki brings me back to my, idk, bootstrapped coder roots.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "But Venki I got to know better, after he started showing up at Mox. He felt kindred, sharing many of my obsessions and my favorite references. In the last couple years, I’ve spent a lot of time with people in EA, which I now consider my adopted tribe; but many conversations with Venki brings me back to my, idk, bootstrapped coder roots.",
            "href": null
          }
        ],
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "35aa6e41-f23e-80bc-9398-df18013218c2",
      "parent": {
        "type": "page_id",
        "page_id": "35aa6e41-f23e-8059-b3bd-fea6199d4b47"
      },
      "created_time": "2026-05-08T05:15:00.000Z",
      "last_edited_time": "2026-05-08T05:28:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
