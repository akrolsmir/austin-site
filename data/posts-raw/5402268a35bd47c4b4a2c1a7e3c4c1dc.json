        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Emotionally stable",
              "link": null
            },
            "annotations": {
              "bold": true,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Emotionally stable",
            "href": null
          },
          {
            "type": "text",
            "text": {
              "content": ". Or perhaps low neuroticism. I almost never get into fights, or express anger at people (I’m a lot more likely to withdraw). I’m fairly self-contained and don’t require much emotional support.",
              "link": null
            },
            "annotations": {
              "bold": false,
