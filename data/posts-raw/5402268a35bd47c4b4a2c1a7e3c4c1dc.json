        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Novelty junkie.",
              "link": null
            },
            "annotations": {
              "bold": true,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Novelty junkie.",
            "href": null
          },
          {
            "type": "text",
            "text": {
              "content": " I thrive in unfamiliar situations, where I have to invent a plan from first principles rather than rotely executing a script. This cashes out to loving new locales, understanding strangers, and taking any class at least once.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": " I thrive in unfamiliar situations, where I have to invent a plan from first principles rather than rotely executing a script. This cashes out to loving new locales, understanding strangers, and taking any class at least once.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
