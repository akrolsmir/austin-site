      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Certainly, people lend me their time, their money, their attention, on the idea that I make good judgments. And people appreciate being in curated environments, surrounded by likeminded, curious peers. ",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Certainly, people lend me their time, their money, their attention, on the idea that I make good judgments. And people appreciate being in curated environments, surrounded by likeminded, curious peers. ",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
