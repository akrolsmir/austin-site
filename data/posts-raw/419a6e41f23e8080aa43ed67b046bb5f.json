      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "It sure would be nice to never have to judge anyone again.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "It sure would be nice to never have to judge anyone again.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
