    {
      "object": "block",
      "id": "419a6e41-f23e-807d-a69d-c045b1ac656e",
      "parent": {
        "type": "page_id",
        "page_id": "419a6e41-f23e-8080-aa43-ed67b046bb5f"
      },
      "created_time": "2026-11-15T23:25:00.000Z",
      "last_edited_time": "2026-11-17T04:32:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "I have often been judged, and often found wanting. These days it’s more silent, when I ping an acquaintance to fund some project of mine, and never hear back. It’s almost a mercy — I can then pretend that they were simply too busy, maybe never even laid eyes on my proposal. (Though I’d ultimately prefer the grace of an explicit “no”).",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "I have often been judged, and often found wanting. These days it’s more silent, when I ping an acquaintance to fund some project of mine, and never hear back. It’s almost a mercy — I can then pretend that they were simply too busy, maybe never even laid eyes on my proposal. (Though I’d ultimately prefer the grace of an explicit “no”).",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "419a6e41-f23e-80c5-b938-fcfa2a4d6a45",
      "parent": {
        "type": "page_id",
        "page_id": "419a6e41-f23e-8080-aa43-ed67b046bb5f"
      },
      "created_time": "2026-11-15T23:36:00.000Z",
      "last_edited_time": "2026-11-17T04:32:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "It wasn’t always this way, though. I was rejected from my first EAG. Rejected from the Future Forum, from EA Bahamas. Every single time I’ve applied to YCombinator. And countless, countless grant applications.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "It wasn’t always this way, though. I was rejected from my first EAG. Rejected from the Future Forum, from EA Bahamas. Every single time I’ve applied to YCombinator. And countless, countless grant applications.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
