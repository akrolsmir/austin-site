      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "There’s this new website, ",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "There’s this new website, ",
            "href": null
          },
          {
            "type": "text",
            "text": {
              "content": "aisafety.fail",
              "link": {
                "url": "https://aisafety.fail/"
              }
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "aisafety.fail",
            "href": "https://aisafety.fail/"
          },
          {
            "type": "text",
            "text": {
              "content": ", which satirizes the silent rejections inherent in the space of AI safety. I don’t think AI safety does particularly badly — in fact, I expect its hiring norms to be exemplary compared to wider tech or nonprofits — but, I get it. One face of the AI safety shoggoth whispers, “apply, apply, we’re desperate for talent, you could save the world, just apply”. And you think, “wow, that could be me”, and you spend weeks of your life lurking and reading and build up the werewithal to apply, and then another shoggoth whacks you on the head, “didn’t you know? we wanted agency, we wanted talent. not, you.”",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": ", which satirizes the silent rejections inherent in the space of AI safety. I don’t think AI safety does particularly badly — in fact, I expect its hiring norms to be exemplary compared to wider tech or nonprofits — but, I get it. One face of the AI safety shoggoth whispers, “apply, apply, we’re desperate for talent, you could save the world, just apply”. And you think, “wow, that could be me”, and you spend weeks of your life lurking and reading and build up the werewithal to apply, and then another shoggoth whacks you on the head, “didn’t you know? we wanted agency, we wanted talent. not, you.”",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
