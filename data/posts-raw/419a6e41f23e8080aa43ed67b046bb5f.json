      "created_time": "2026-11-15T23:18:00.000Z",
      "last_edited_time": "2026-11-15T23:22:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
