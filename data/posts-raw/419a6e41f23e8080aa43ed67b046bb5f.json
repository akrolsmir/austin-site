    {
      "object": "block",
      "id": "41ba6e41-f23e-8043-adf9-cac655177fd4",
      "parent": {
        "type": "page_id",
        "page_id": "419a6e41-f23e-8080-aa43-ed67b046bb5f"
      },
      "created_time": "2026-11-17T04:11:00.000Z",
      "last_edited_time": "2026-11-17T04:43:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "has_children": false,
      "in_trash": false,
      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "And, it turns out the world might already be less gated than you think. EA, AI safety, the world overall, are best modeled as doocracies; anyone can “be the change”. If you’re unhappy with how a certain fellowship is run, start your own. If you don’t like how one org hires, create a competitor. My exhortation to the folks who resonate with ",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "And, it turns out the world might already be less gated than you think. EA, AI safety, the world overall, are best modeled as doocracies; anyone can “be the change”. If you’re unhappy with how a certain fellowship is run, start your own. If you don’t like how one org hires, create a competitor. My exhortation to the folks who resonate with ",
            "href": null
          },
          {
            "type": "text",
            "text": {
              "content": "aisafety.fail",
              "link": {
                "url": "http://aisafety.fail/"
              }
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "aisafety.fail",
            "href": "http://aisafety.fail/"
          },
          {
            "type": "text",
            "text": {
              "content": " is to carve your own path, do good work in the world, and don’t care overmuch what the gatekeepers think. It’s not the ten (or hundred) rejections that anyone remembers, it’s the one success.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": " is to carve your own path, do good work in the world, and don’t care overmuch what the gatekeepers think. It’s not the ten (or hundred) rejections that anyone remembers, it’s the one success.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
