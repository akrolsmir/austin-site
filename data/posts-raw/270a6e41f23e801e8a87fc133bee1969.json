      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "This is a bad answer. You should just apply to all the places in parallel, rather than asking funders one at a time.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "This is a bad answer. You should just apply to all the places in parallel, rather than asking funders one at a time.",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
