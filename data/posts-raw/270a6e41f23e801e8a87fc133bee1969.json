      "bulleted_list_item": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Funders generally expect that you're applying to multiple places anyways, this is totally normal. (It's nice to mention in the application that you're doing this, though!)",
              "link": null
