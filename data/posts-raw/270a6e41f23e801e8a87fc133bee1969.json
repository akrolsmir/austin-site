      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "As I review funding applications, an answer I often see for \"what would you do if you don't get funded\" is: \"I'd apply for funding elsewhere\".",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "As I review funding applications, an answer I often see for \"what would you do if you don't get funded\" is: \"I'd apply for funding elsewhere\".",
            "href": null
          }
        ],
        "icon": null,
        "color": "default"
      }
    },
    {
      "object": "block",
      "id": "270a6e41-f23e-8081-ad3f-f0c127b728ee",
      "parent": {
        "type": "page_id",
        "page_id": "270a6e41-f23e-801e-8a87-fc133bee1969"
      },
      "created_time": "2025-09-16T17:29:00.000Z",
      "last_edited_time": "2025-09-16T17:29:00.000Z",
      "created_by": {
        "object": "user",
        "id": "00c350d3-9f7b-4bc1-b27d-24e15ac5139f"
      },
      "last_edited_by": {
